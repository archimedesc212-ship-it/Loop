%% MUSE — complete database ERD (Mermaid erDiagram)
%% Generated from the live MySQL schema (baseline 01–06 + migrations 0001, 0002, 0003, 0004) by backend/scripts/erd/build_erd.py
%% Cardinality: ||--o{ one-to-many (FK NOT NULL), |o..o{ (FK nullable), ||--o| one-to-one;
%% "--" identifying (FK is part of the child PK), ".." non-identifying. Only key columns are listed.
erDiagram
  %% ---- 1 · Users, Profiles & Access Control
  roles {
    tinyint role_id PK
    varchar(20) code UK
  }
  permissions {
    varchar(40) permission_code PK
  }
  role_permissions {
    tinyint role_id PK, FK
    varchar(40) permission_code PK, FK
  }
  users {
    int user_id PK
    tinyint role_id FK
    varchar(30) username UK
    varchar(120) email UK
  }
  user_profiles {
    int user_id PK, FK
    varchar(6) region_code FK "nullable"
  }
  auth_sessions {
    char(16) session_id PK
    int user_id FK
    char(64) token_hash UK
  }
  %% ---- 2 · Music Catalogue
  languages {
    smallint language_id PK
    varchar(3) iso_code UK
    varchar(40) name UK
  }
  regions {
    varchar(6) region_code PK
    smallint primary_language_id FK "nullable"
    varchar(60) name UK
  }
  artists {
    int artist_id PK
    varchar(6) region_code FK "nullable"
    smallint primary_language_id FK "nullable"
    varchar(100) normalized_name UK "nullable, generated"
    varchar(80) disambiguation UK
  }
  artist_aliases {
    int alias_id PK
    int artist_id FK, UK
    varchar(100) normalized_alias UK "nullable, generated"
  }
  films {
    int film_id PK
    smallint language_id FK, UK
    varchar(150) title UK
    smallint release_year UK
  }
  albums {
    int album_id PK
    int film_id FK "nullable"
    smallint language_id FK "nullable"
  }
  album_artists {
    int album_id PK, FK
    int artist_id PK, FK
  }
  songs {
    int song_id PK
    int primary_artist_id FK, UK
    int album_id FK "nullable"
    smallint language_id FK "nullable"
    int merged_into_song_id FK "nullable"
    varchar(150) normalized_title UK "nullable, generated"
    varchar(40) version_label UK
    char(12) isrc UK "nullable"
  }
  song_artists {
    int song_id PK, FK
    int artist_id PK, FK
    enum role PK
  }
  genres {
    smallint genre_id PK
    smallint parent_genre_id FK "nullable"
    varchar(40) name UK
  }
  song_genres {
    int song_id PK, FK
    smallint genre_id PK, FK
    int primary_song_key UK "nullable, generated"
  }
  %% ---- 3 · Mood & Audio Intelligence
  mood_categories {
    tinyint category_id PK
    varchar(40) name UK
    enum quadrant UK
  }
  moods {
    smallint mood_id PK
    tinyint category_id FK
    varchar(30) name UK
  }
  mood_keywords {
    int keyword_id PK
    smallint mood_id FK, UK
    varchar(60) phrase UK
  }
  contexts {
    tinyint context_id PK
    varchar(20) code UK
  }
  context_keywords {
    varchar(60) phrase PK
    tinyint context_id FK
  }
  context_moods {
    tinyint context_id PK, FK
    smallint mood_id PK, FK
  }
  intelligence_models {
    smallint model_id PK
    enum kind UK
    varchar(40) name UK
    varchar(20) version UK
    varchar(20) active_kind UK "nullable, generated"
  }
  model_parameters {
    smallint model_id PK, FK
    varchar(40) param_code PK
  }
  audio_features {
    int feature_id PK
    int song_id FK, UK
    smallint model_id FK, UK
    int current_song_key UK "nullable, generated"
  }
  song_moods {
    int song_id PK, FK
    smallint mood_id PK, FK
    smallint model_id PK, FK
    int feature_id FK
  }
  mood_segments {
    int segment_id PK
    int song_id FK, UK
    smallint model_id FK, UK
    smallint mood_id FK
    tinyint segment_index UK
  }
  song_mood_curations {
    int song_id PK, FK
    smallint mood_id PK, FK
    int curated_by FK "nullable"
  }
  %% ---- 4 · Listening History & Feedback
  listening_sessions {
    bigint session_id PK, UK
    int user_id FK, UK
    tinyint context_id FK "nullable"
  }
  listening_history {
    bigint play_id PK
    bigint session_id FK
    int user_id FK
    int song_id FK
    bigint batch_id FK "nullable"
  }
  playback_events {
    bigint event_id PK
    bigint play_id FK
  }
  ratings {
    int user_id PK, FK
    int song_id PK, FK
  }
  song_mood_ratings {
    int user_id PK, FK
    int song_id PK, FK
    smallint mood_id PK, FK
  }
  user_likes {
    int user_id PK, FK
    int song_id PK, FK
  }
  song_dismissals {
    int user_id PK, FK
    int song_id PK, FK
    bigint batch_id FK "nullable"
  }
  search_history {
    bigint search_id PK
    int user_id FK
  }
  incognito_sessions {
    bigint incognito_id PK
    int user_id FK
    smallint current_mood_id FK "nullable"
    int active_user_key UK "nullable, generated"
  }
  incognito_events {
    bigint event_id PK
    bigint incognito_id FK
    int song_id FK
  }
  %% ---- 5 · Recommendation Engine
  recommendation_batches {
    bigint batch_id PK
    int user_id FK
    bigint incognito_id FK "nullable"
    smallint model_id FK
    tinyint context_id FK "nullable"
    int seed_song_id FK "nullable"
    smallint language_id FK "nullable"
  }
  recommendation_batch_moods {
    bigint batch_id PK, FK
    smallint mood_id PK, FK
  }
  recommendation_items {
    bigint batch_id PK, FK, UK
    int song_id PK, FK
    smallint rank_position UK
  }
  recommendation_reasons {
    bigint batch_id PK, FK
    int song_id PK, FK
    varchar(30) reason_code PK, FK
  }
  reason_types {
    varchar(30) reason_code PK
  }
  %% ---- 6 · Playlists & Preferences
  playlists {
    int playlist_id PK
    int user_id FK, UK
    bigint source_batch_id FK "nullable"
    varchar(80) name UK
  }
  playlist_songs {
    int playlist_id PK, FK
    int song_id PK, FK
  }
  user_languages {
    int user_id PK, FK, UK
    smallint language_id PK, FK
    tinyint priority UK
  }
  user_genre_preferences {
    int user_id PK, FK
    smallint genre_id PK, FK
    smallint model_id FK "nullable"
  }
  user_artist_preferences {
    int user_id PK, FK
    int artist_id PK, FK
    smallint model_id FK "nullable"
  }
  user_mood_preferences {
    int user_id PK, FK
    smallint mood_id PK, FK
    smallint model_id FK "nullable"
  }
  user_context_preferences {
    int user_id PK, FK
    tinyint context_id PK, FK
  }
  %% ---- 7 · Music Sources & Data Pipeline
  music_sources {
    smallint source_id PK
    smallint fallback_source_id FK "nullable"
    varchar(30) code UK
  }
  song_media {
    int media_id PK
    int song_id FK, UK
    smallint source_id FK, UK
    enum media_type UK
  }
  source_records {
    bigint record_id PK
    smallint source_id FK, UK
    int song_id FK "nullable"
    int artist_id FK "nullable"
    int album_id FK "nullable"
    int film_id FK "nullable"
    bigint last_job_id FK "nullable"
    enum entity_type UK
    varchar(100) external_id UK
  }
  pipeline_jobs {
    bigint job_id PK
    bigint parent_job_id FK "nullable"
    smallint source_id FK "nullable"
    int requested_by FK "nullable"
    varchar(120) idempotency_key UK
  }
  pipeline_job_logs {
    bigint log_id PK
    bigint job_id FK
    bigint record_id FK "nullable"
  }
  review_queue {
    bigint review_id PK
    bigint record_id FK "nullable"
    int candidate_song_id FK "nullable"
    bigint job_id FK "nullable"
    int decided_by FK "nullable"
    varchar(80) pending_key UK "nullable, generated"
  }
  %% ---- 8 · MUSE World, Trends & Audit
  world_archetypes {
    varchar(20) archetype_code PK
    varchar(40) name UK
  }
  archetype_moods {
    varchar(20) archetype_code PK, FK
    smallint mood_id PK, FK
  }
  weekly_worlds {
    bigint world_id PK
    int user_id FK, UK
    varchar(20) archetype_code FK
    smallint primary_mood_id FK
    smallint language_id FK "nullable"
    varchar(6) region_code FK "nullable"
    bigint batch_id FK, UK
    bigint job_id FK "nullable"
    date week_start UK
    smallint version UK
    varchar(30) active_key UK "nullable, generated"
  }
  world_feedback {
    int user_id PK, FK
    bigint world_id PK, FK
  }
  trend_snapshots {
    bigint snapshot_id PK
    bigint job_id FK, UK
    varchar(6) region_code FK "nullable"
    enum window_code UK
    enum entity_type UK
    int entity_id UK
    varchar(6) region_key UK "nullable, generated"
  }
  audit_logs {
    bigint audit_id PK
    int actor_user_id FK "nullable"
  }
  schema_migrations {
    char(4) version PK
  }
