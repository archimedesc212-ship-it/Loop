# ======================================================================
#  MUSE environment — copy to .env and fill in.  cp .env.example .env
#  .env is git-ignored. This file contains PLACEHOLDERS ONLY: never put a
#  real password or key here. Full reference: docs/ENVIRONMENT.md
# ======================================================================

# --- MySQL 8.0.19+ -----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=muse
# Owner account: used ONLY by db:setup / db:migrate / db:verify (schema changes).
DB_OWNER_USER=muse_owner
DB_OWNER_PASSWORD=change_me_owner
# Least-privilege account the API uses at runtime (created by db:setup).
# Use a different DB_APP_USER for every database on the same server.
DB_APP_USER=muse_app
DB_APP_PASSWORD=change_me_app
DB_APP_HOST=localhost
# Time zone of the API's database sessions (NOW(), "today", week boundaries). India: +05:30
DB_TIMEZONE=+00:00

# --- API ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Keys the CSRF tokens and IP hashes. At least 32 random characters (required in production):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret
# Sign-in session lifetime in hours (1–720)
SESSION_TTL_HOURS=12
# Secure cookies need HTTPS. Default: true when NODE_ENV=production, false otherwise.
COOKIE_SECURE=
# Number of reverse proxies in front of the API (0 = none). Needed for correct client IPs.
TRUST_PROXY=0
# Browser origins allowed to call the API cross-origin (comma-separated). Same-origin needs none.
CORS_ORIGIN=http://localhost:5173
# Failed sign-in/registration attempts per IP per 15 minutes; writes per minute per IP
RATE_LIMIT_AUTH_FAILURES=20
RATE_LIMIT_WRITES_PER_MIN=240

# --- Background jobs (scheduler inside the API process) ----------------
JOBS_ENABLED=true
# Idle minutes before an open listening session is closed
SESSION_IDLE_MINUTES=30
# Private (incognito) session lifetime in minutes
INCOGNITO_TTL_MINUTES=120

# --- External providers: ALL OFF by default. MUSE runs fully without them.
#     See docs/PROVIDERS.md for what each needs and how to test it.
PROVIDER_TIMEOUT_MS=8000
PROVIDER_RETRIES=2

# MusicBrainz (metadata; no key, but a User-Agent with contact details is required)
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_USER_AGENT=
# MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2

# TMDB (film details for soundtracks). Set ONE of the two credentials.
TMDB_ENABLED=false
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
# TMDB_BASE_URL=https://api.themoviedb.org/3

# YouTube Data API v3 (video links, metadata only)
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
# YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3

# TheAudioDB (artist banners/fanart and album artwork; metadata only)
# Shared public key 123 is for development/testing. Confirm licence before production use.
THEAUDIODB_ENABLED=false
THEAUDIODB_API_KEY=123
# THEAUDIODB_BASE_URL=https://www.theaudiodb.com/api/v1/json

# Licensed preview provider (vendor-neutral contract, see docs/PROVIDERS.md)
EXTERNAL_PREVIEW_ENABLED=false
EXTERNAL_PREVIEW_BASE_URL=
EXTERNAL_PREVIEW_API_KEY=
# Origin the browser loads preview audio from, e.g. https://cdn.example.com (added to the CSP)
EXTERNAL_PREVIEW_MEDIA_ORIGIN=

# Local licensed audio files (on by default; the folder may be empty)
LOCAL_MEDIA_ENABLED=true
# Default: <repo>/media
LOCAL_MEDIA_DIR=

# Optional AI fallback for free-text mood input (none | anthropic)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL=https://api.anthropic.com/v1
AI_TIMEOUT_MS=10000
